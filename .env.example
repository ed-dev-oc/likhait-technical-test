# Docker Compose environment variables — EXAMPLE TEMPLATE
# Copy this file to .env and fill in your own values.
# The .env file is gitignored; this .env.example is committed as documentation.

# ── Database ──────────────────────────────────────────────────────────────────
# DB_ROOT_PASSWORD is used only by the MySQL container internally.
# DB_USERNAME / DB_PASSWORD are the credentials the Rails app uses (least-privilege user).
DB_ROOT_PASSWORD=change-me-root
DB_NAME=expense_system_development
DB_USERNAME=expense_user
DB_PASSWORD=change-me-app

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call the API.
# In production, replace with your deployed frontend URL.
# Example: ALLOWED_ORIGINS=https://app.myexpenses.com
ALLOWED_ORIGINS=http://localhost:5173
